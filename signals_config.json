{
  "version": "3.0",
  "description": "四足机器狗能量测试管理平台 - 信号配置（设备分组写法）。devices 下每个设备有 id（设备查找键，设备间唯一）、name（展示名）、api（采集函数名）；设备级字段不再重复写到信号里。每条信号只保留 id（必填，全项目唯一）、enabled（null=待定 / true=启用 / false=停用）、ch（UT3200 通道号）与展示列 name/unit/min/max/fmt。",
  "devices": [
    {
      "id": "dog",
      "name": "四足机器狗",
      "api": "udp.parse_frame",
      "signals": [
        {
          "id": "fl_hip_winding_temp",
          "enabled": null,
          "name": "左前腿髋关节绕组温度",
          "unit": "°C",
          "min": -20,
          "max": 150,
          "fmt": "{:.1f}"
        },
        {
          "id": "fl_hip_casing_temp",
          "enabled": null,
          "name": "左前腿髋关节壳体温度",
          "unit": "°C",
          "min": -20,
          "max": 150,
          "fmt": "{:.1f}"
        },
        {
          "id": "fl_hip_current",
          "enabled": null,
          "name": "左前腿髋关节电流",
          "unit": "A",
          "min": 0,
          "max": 50,
          "fmt": "{:.2f}"
        }
      ]
    },
    {
      "id": "ut3200",
      "name": "UT3200+ 多路温度测试仪",
      "api": "ut3200.fetch_all",
      "signals": [
        {
          "id": "ut3200_ch1",
          "enabled": true,
          "ch": 1,
          "name": "UT3200+ 通道1 温度",
          "unit": "°C",
          "min": -200,
          "max": 1800,
          "fmt": "{:.1f}"
        },
        {
          "id": "ut3200_ch2",
          "enabled": true,
          "ch": 2,
          "name": "UT3200+ 通道2 温度",
          "unit": "°C",
          "min": -200,
          "max": 1800,
          "fmt": "{:.1f}"
        },
        {
          "id": "ut3200_ch3",
          "enabled": true,
          "ch": 3,
          "name": "UT3200+ 通道3 温度",
          "unit": "°C",
          "min": -200,
          "max": 1800,
          "fmt": "{:.1f}"
        },
        {
          "id": "ut3200_ch4",
          "enabled": true,
          "ch": 4,
          "name": "UT3200+ 通道4 温度",
          "unit": "°C",
          "min": -200,
          "max": 1800,
          "fmt": "{:.1f}"
        },
        {
          "id": "ut3200_ch5",
          "enabled": false,
          "ch": 5,
          "name": "UT3200+ 通道5 温度",
          "unit": "°C",
          "min": -200,
          "max": 1800,
          "fmt": "{:.1f}"
        },
        {
          "id": "ut3200_ch6",
          "enabled": false,
          "ch": 6,
          "name": "UT3200+ 通道6 温度",
          "unit": "°C",
          "min": -200,
          "max": 1800,
          "fmt": "{:.1f}"
        },
        {
          "id": "ut3200_ch7",
          "enabled": false,
          "ch": 7,
          "name": "UT3200+ 通道7 温度",
          "unit": "°C",
          "min": -200,
          "max": 1800,
          "fmt": "{:.1f}"
        },
        {
          "id": "ut3200_ch8",
          "enabled": false,
          "ch": 8,
          "name": "UT3200+ 通道8 温度",
          "unit": "°C",
          "min": -200,
          "max": 1800,
          "fmt": "{:.1f}"
        }
      ]
    },
    {
      "id": "can",
      "name": "CAN 设备（预留）",
      "api": "can.read_motor_temp",
      "signals": [
        {
          "id": "can_motor_temp",
          "enabled": false,
          "name": "CAN电机温度(示例)",
          "unit": "°C",
          "min": -20,
          "max": 150,
          "fmt": "{:.1f}"
        }
      ]
    }
  ]
}
